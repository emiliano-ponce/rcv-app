# Route by hostname to each app's container over the shared "edge" network.
# No TLS config needed here — Cloudflare terminates HTTPS at the edge, and
# the tunnel-to-Caddy hop stays inside the private Docker network.
{
	auto_https off
}

rcv.yourdomain.com:80 {
	reverse_proxy rcv-app:8080
}

