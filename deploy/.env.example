# Copy to deploy/.env and fill in real values. Never commit the real file.

# Turso (libsql) database
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=replace-me

# Cloudflare Turnstile (leave both blank + DISABLE_TURNSTILE_VERIFY=false in
# prod once you have real keys; blank keys auto-disable verification in dev only)
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# Optional overrides (defaults shown)
APP_ENV=production
DISABLE_TURNSTILE_VERIFY=false
ALLOW_DEV_MULTI_VOTE=false
RCV_CREATE_RATE_LIMIT_PER_MIN=5
RCV_VOTE_RATE_LIMIT_PER_MIN=15
